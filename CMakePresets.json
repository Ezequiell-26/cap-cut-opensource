{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "CCOS Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CCOS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "CCOS Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CCOS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "CCOS AddressSanitizer + UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "professional",
      "displayName": "CCOS Professional Interchange + Color",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/professional",
      "cacheVariables": {
        "CCOS_ENABLE_OPENTIMELINEIO": "ON",
        "CCOS_ENABLE_OPENCOLORIO": "ON"
      }
    },
    {
      "name": "open-source-extensions",
      "displayName": "CCOS Extended Open Source Tooling",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/open-source-extensions",
      "cacheVariables": {
        "CCOS_ENABLE_MIT_MEDIA_3D": "ON",
        "CCOS_ENABLE_MIT_TOOLING": "ON",
        "CCOS_ENABLE_MINIAUDIO": "ON",
        "CCOS_ENABLE_MIT_UI_EXTENSIONS": "ON",
        "CCOS_ENABLE_MIT_DIAGNOSTICS": "ON",
        "CCOS_ENABLE_MIT_STORAGE": "ON",
        "CCOS_ENABLE_MIT_COMPRESSION": "ON",
        "CCOS_ENABLE_MIT_UTILITY_EXTENSIONS": "ON",
        "CCOS_ENABLE_UTF8_HEADER": "ON"
      }
    },
    {
      "name": "professional-media",
      "displayName": "CCOS Professional Media Backends (Audited Host)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/professional-media",
      "cacheVariables": {
        "CCOS_ENABLE_PRO_TEXT": "ON",
        "CCOS_ENABLE_PRO_IMAGE_IO": "ON",
        "CCOS_ENABLE_PRO_AUDIO_IO": "ON",
        "CCOS_ENABLE_PRO_CODECS": "ON",
        "CCOS_ENABLE_PRO_STORAGE": "ON"
      }
    },
    {
      "name": "web",
      "displayName": "CCOS WebAssembly (Qt WASM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{QT_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "CCOS_BUILD_TESTS": "OFF",
        "CCOS_BUILD_CLI": "OFF",
        "CCOS_FETCH_GTEST": "OFF",
        "CCOS_ENABLE_LOCAL_AUTOMATION_API": "OFF",
        "CCOS_ENABLE_LLAMA_SERVER_PROFILE": "OFF",
        "CCOS_ENABLE_CULTURAL_MEDIA_API": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "configuration": "Debug" },
    { "name": "professional", "configurePreset": "professional", "configuration": "Release" },
    { "name": "open-source-extensions", "configurePreset": "open-source-extensions", "configuration": "Debug" },
    { "name": "professional-media", "configurePreset": "professional-media", "configuration": "Release" },
    { "name": "web", "configurePreset": "web", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "professional", "configurePreset": "professional", "output": { "outputOnFailure": true } },
    { "name": "open-source-extensions", "configurePreset": "open-source-extensions", "output": { "outputOnFailure": true } },
    { "name": "professional-media", "configurePreset": "professional-media", "output": { "outputOnFailure": true } }
  ]
}
